# apps/server reads these. Never put real values in this file.
ANTHROPIC_API_KEY=
# Model id when MARGIN_MODEL=anthropic, and the output-token cap per agent run.
MARGIN_ANTHROPIC_MODEL=claude-opus-5-5
MARGIN_MAX_OUTPUT_TOKENS=16000
# "mock" uses the deterministic mock model (tests, offline dev). "anthropic" calls Claude.
MARGIN_MODEL=mock
PORT=8790
WEB_ORIGIN=http://localhost:5173
MARGIN_DB_PATH=./data/margin.db
# Required in production, at least 32 characters.
MARGIN_TOKEN_SECRET=
