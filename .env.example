# apps/server reads these. Never put real values in this file.
ANTHROPIC_API_KEY=
# Model id when MARGIN_MODEL=anthropic, and the output-token cap per agent run.
MARGIN_ANTHROPIC_MODEL=claude-haiku-5-5
MARGIN_MAX_OUTPUT_TOKENS=16000
# "mock" uses the deterministic mock model (tests, offline dev). "anthropic" calls Claude.
MARGIN_MODEL=mock
PORT=8790
# Public demo protection (defaults shown): agent runs per UTC day, document cap,
# optional nightly reset hour (UTC), and trusting X-Forwarded-For behind a proxy.
# DAILY_AGENT_RUN_LIMIT=300
# MAX_DOCUMENTS=200
# DEMO_RESET_HOUR_UTC=3
# TRUST_PROXY=false
# Production only: listen on all interfaces, and serve the built web app from this process.
# HOST=0.0.0.0
# MARGIN_WEB_DIST=../web/dist
WEB_ORIGIN=http://localhost:5173
MARGIN_DB_PATH=./data/margin.db
# Required in production, at least 32 characters.
MARGIN_TOKEN_SECRET=
