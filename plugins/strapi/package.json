{
  "name": "@margin/strapi-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Margin's agent panel in the Strapi 5 Content Manager (ADR 0010).",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "typecheck": "tsc -p admin/tsconfig.json && tsc -p server/tsconfig.json"
  },
  "devDependencies": {
    "@margin/agent-panel": "workspace:*",
    "@margin/agent-token": "workspace:*",
    "@margin/shared": "workspace:*",
    "@strapi/content-manager": "5.59.0",
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.59.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "styled-components": "6.6.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.59.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "margin",
    "displayName": "Margin",
    "description": "An AI agent that proposes edits; nothing changes until you accept."
  }
}
